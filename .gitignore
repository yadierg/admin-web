cd ~/Documentos/Proyectos/admin-web

cat > .gitignore <<'EOF'
# ─────────────────────────────────────────────
# Angular / Build
# ─────────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache

# ─────────────────────────────────────────────
# Node
# ─────────────────────────────────────────────
/node_modules
npm-debug.log
yarn-error.log
.pnpm-debug.log*

# ─────────────────────────────────────────────
# Jest / Coverage
# ─────────────────────────────────────────────
/coverage
/junit
*.lcov
__screenshots__/

# ─────────────────────────────────────────────
# IDEs and editors
# ─────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.iml
*.swp
*.swo
*~

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ─────────────────────────────────────────────
# Misc
# ─────────────────────────────────────────────
.sass-cache/
/connect.lock
/libpeerconnection.log
testem.log
/typings

# ─────────────────────────────────────────────
# System files
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────
# Env / secrets (locales)
# ─────────────────────────────────────────────
# environment.ts y environment.prod.ts SÍ se commitean
# (solo contienen apiUrl y tenantId, que es público)
/src/environments/environment.local.ts
.env
.env.*
!.env.example

# ─────────────────────────────────────────────
# Logs y temporales
# ─────────────────────────────────────────────
*.log
.cache
*.sh
temp/
EOF